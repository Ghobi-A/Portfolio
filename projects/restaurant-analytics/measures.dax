// One definition at a time in Power BI. Table name is 'Orders'; measure name avoids collision.
// All measures respect current order/date/type/status filters unless explicitly labelled.
Total Orders = COUNTROWS('Orders')
Gross Order Value = SUM('Orders'[gross_order_value_gbp])
Average Order Value = DIVIDE([Gross Order Value], [Total Orders])
Confirmed Card Value = SUM('Orders'[confirmed_card_value_gbp])
Offline Order Value = SUM('Orders'[offline_order_value_gbp])
Confirmed Offline Order Value = SUM('Orders'[confirmed_offline_order_value_gbp])
Unverified Order Value = [Gross Order Value] - [Confirmed Card Value]
Cancelled Orders = SUM('Orders'[is_cancelled])
Cancellation Rate = DIVIDE([Cancelled Orders], [Total Orders])
Failed Payment Orders = SUM('Orders'[is_payment_failed])
Payment Failure Rate = DIVIDE([Failed Payment Orders], [Total Orders])
Card Orders = SUM('Orders'[is_card_order])
Card Payment Failure Rate = DIVIDE(CALCULATE([Failed Payment Orders], KEEPFILTERS('Orders'[payment_method] = "card")), [Card Orders])
Completed Timestamp Orders = SUM('Orders'[has_completion_timestamp])
Orders With Prep Timing = COUNT('Orders'[preparation_minutes])
Prep Timing Coverage = DIVIDE([Orders With Prep Timing], [Total Orders])
Median Prep Minutes = MEDIAN('Orders'[preparation_minutes])
Average Prep Minutes = AVERAGE('Orders'[preparation_minutes])
P90 Prep Minutes = IF([Orders With Prep Timing] > 0, PERCENTILEX.INC(FILTER('Orders', NOT ISBLANK('Orders'[preparation_minutes])), 'Orders'[preparation_minutes], 0.9))
Prep Over 120 Min = SUM('Orders'[is_prep_outlier])
Prep Over 120 Min Rate = DIVIDE([Prep Over 120 Min], [Orders With Prep Timing])
Overnight Prep Orders = SUM('Orders'[is_overnight_prep])
Median Acknowledgement Minutes = MEDIAN('Orders'[acknowledgement_minutes])
Median Lifecycle Minutes = MEDIAN('Orders'[lifecycle_minutes])
Missing Preparing Orders = SUM('Orders'[missing_preparing])
Missing Ready Orders = SUM('Orders'[missing_ready])
Missing Completed Orders = SUM('Orders'[missing_completed])
Missing Acknowledgement Orders = SUM('Orders'[missing_acknowledged])
Invalid Timestamp Orders = SUM('Orders'[invalid_timestamp_sequence])
Payment Inconsistency Orders = SUM('Orders'[inconsistent_payment_state])
Invalid Items Orders = SUM('Orders'[invalid_items_container]) + SUM('Orders'[empty_items])
Invalid Item Lines = SUM('Orders'[invalid_item_lines])
Monetary Warning Orders = SUM('Orders'[money_warning])
Item Subtotal Mismatch Orders = COUNTROWS(FILTER('Orders', NOT ISBLANK('Orders'[item_subtotal_delta_gbp]) && ABS('Orders'[item_subtotal_delta_gbp]) > 0.01))
Order Total Mismatch Orders = COUNTROWS(FILTER('Orders', NOT ISBLANK('Orders'[order_total_delta_gbp]) && ABS('Orders'[order_total_delta_gbp]) > 0.01))
Menu Units = CALCULATE(SUM('MenuItems'[quantity]), KEEPFILTERS('MenuItems'[is_invalid_line] = 0))
Menu Line Value = CALCULATE(SUM('MenuItems'[indicative_line_value_gbp]), KEEPFILTERS('MenuItems'[is_invalid_line] = 0))
Orders Containing Product = CALCULATE(DISTINCTCOUNT('MenuItems'[order_id]), KEEPFILTERS('MenuItems'[is_invalid_line] = 0))
Product Popularity Rank = IF(NOT ISBLANK([Menu Units]), RANKX(ALLSELECTED('Products'), [Menu Units], , DESC, DENSE))
Notification Events = SUM('Notifications'[notification_events])
Sent Notification Events = SUM('Notifications'[sent_notification_events])
Failed Notification Events = SUM('Notifications'[failed_notification_events])
Pending Notification Events = SUM('Notifications'[pending_notification_events])
Notification Sent Rate = DIVIDE([Sent Notification Events], [Notification Events])
Notification Attempts = SUM('Notifications'[notification_attempts])
Retry Attempts = SUM('Notifications'[retry_attempts])
Failed Endpoints = SUM('Notifications'[failed_endpoints])
Delivered Endpoints = SUM('Notifications'[delivered_endpoints])
Orders With Notification Failures = SUM('Notifications'[has_notification_failure])
// Model pairs as a fact with one row per order and unordered distinct product pair.
Pair Orders = DISTINCTCOUNT('ItemPairs'[order_id])
Pair Support = DIVIDE([Pair Orders], [Total Orders])
Unitemised Adjustment = SUM('Orders'[unitemised_adjustment_gbp])
Missing Created Orders = SUM('Orders'[missing_created])
Orders With Outbox Records = COUNTROWS(FILTER('Notifications', 'Notifications'[notification_events] > 0))
Outbox Coverage All Orders = DIVIDE([Orders With Outbox Records], [Total Orders])
